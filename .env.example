# OverSight runs fully without any of these. Leave them unset for the
# deterministic semantic rule engine (recommended for a reliable demo).

# Optional: OpenAI-compatible provider for semantic risk analysis.
# Only approval-request TEXT is sent, server-side. Camera data never leaves the browser.
# OVERSIGHT_AI_API_KEY=sk-...            # or OPENAI_API_KEY
# OVERSIGHT_AI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint (vLLM, Ollama, OpenRouter...)
# OVERSIGHT_AI_MODEL=gpt-4o-mini
# OVERSIGHT_AI_TIMEOUT_MS=12000
